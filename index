  <style>
:root{--accent:#C8A96E}
/* LVO Holdings — shared division-site stylesheet
   Each page sets :root{--accent:#hex} and includes only its own content. */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --red:#8B0000;--red-hi:#CC2020;
  --chrome:#C8C8D0;--white:#F0EEEC;
  --dim:#888880;--bg:#000000;
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--white);font-family:'Cormorant Garamond',Georgia,serif;overflow-x:hidden;cursor:default}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.03;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
.page{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;padding:1.8rem 4rem;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(to bottom,rgba(5,5,5,.97),transparent)}
.nav-left{display:flex;flex-direction:column;gap:.2rem}
.nav-parent{font-family:'Cinzel',serif;font-size:.48rem;letter-spacing:.35em;color:var(--red-hi);text-decoration:none;text-transform:uppercase;transition:color .3s}
.nav-parent:hover{color:var(--chrome)}
.nav-mark{font-family:'Cinzel',serif;font-size:.95rem;font-weight:600;letter-spacing:.3em;color:var(--accent);text-decoration:none}
.nav-right{display:flex;align-items:center;gap:1.5rem}
.nav-tag{font-family:'Cinzel',serif;font-size:.52rem;letter-spacing:.25em;color:var(--dim);text-transform:uppercase}
#navUserBtn{display:none;align-items:center;gap:1rem}
#navUserBtn.show{display:flex}
.nav-dash-link{font-family:'Cinzel',serif;font-size:.48rem;letter-spacing:.3em;color:var(--accent);text-decoration:none;text-transform:uppercase;border:.5px solid color-mix(in srgb,var(--accent) 35%,transparent);padding:.35rem .75rem;transition:background .25s,border-color .25s}
.nav-dash-link:hover{background:color-mix(in srgb,var(--accent) 10%,transparent);border-color:var(--accent)}

/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:7rem 2rem 4rem;position:relative}
.hero::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(600px,90vw);height:min(600px,90vw);border-radius:50%;pointer-events:none;
  background:radial-gradient(circle,color-mix(in srgb,var(--accent) 7%,transparent) 0%,transparent 70%)}
.hero-label{font-family:'Cinzel',serif;font-size:.52rem;letter-spacing:.5em;color:var(--red-hi);text-transform:uppercase;margin-bottom:1.5rem;opacity:0;animation:fadeUp 1s cubic-bezier(.16,1,.3,1) .3s forwards}
.hero-title{font-family:'Cinzel',serif;font-size:clamp(2.2rem,8vw,5rem);font-weight:900;letter-spacing:.2em;color:var(--accent);line-height:1;margin-bottom:.5rem;opacity:0;animation:fadeUp 1s cubic-bezier(.16,1,.3,1) .5s forwards}
.hero-sub{font-family:'Cinzel',serif;font-size:clamp(.48rem,1.5vw,.65rem);letter-spacing:.4em;color:var(--dim);text-transform:uppercase;margin-bottom:3rem;opacity:0;animation:fadeUp 1s cubic-bezier(.16,1,.3,1) .7s forwards}
.hero-statement{font-size:clamp(1rem,3vw,1.5rem);font-weight:300;font-style:italic;line-height:1.8;color:var(--white);opacity:0;max-width:600px;animation:fadeUp 1s cubic-bezier(.16,1,.3,1) .9s forwards}
.hero-rule{width:1px;height:60px;background:linear-gradient(to bottom,transparent,var(--accent),transparent);margin:3rem auto 0;opacity:0;animation:fadeIn 1s ease 1.4s forwards}

/* DIVIDER */
.section-divider{display:flex;align-items:center;gap:1.5rem;padding:0 2rem;margin:5rem auto;max-width:900px;width:100%}
.section-divider::before,.section-divider::after{content:'';flex:1;height:.5px;background:linear-gradient(to right,transparent,var(--accent) 40%,transparent)}
.section-divider span{font-family:'Cinzel',serif;font-size:.55rem;letter-spacing:.4em;color:var(--accent);white-space:nowrap}

/* PILLARS */
.pillars{padding:0 2rem;max-width:1100px;margin:0 auto;width:100%}
.pillars-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:.5px solid color-mix(in srgb,var(--accent) 20%,transparent)}
.pillar{padding:3rem 2rem;border-right:.5px solid color-mix(in srgb,var(--accent) 12%,transparent);border-bottom:.5px solid color-mix(in srgb,var(--accent) 12%,transparent);position:relative;overflow:hidden;transition:background .4s}
.pillar:first-child{grid-column:1/-1;border-bottom:.5px solid color-mix(in srgb,var(--accent) 12%,transparent);padding:3.5rem 2rem}
.pillar:nth-child(2){border-right:.5px solid color-mix(in srgb,var(--accent) 12%,transparent)}
.pillar:last-child{border-right:none;border-bottom:none}
.pillar::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,var(--accent),transparent);transform:scaleX(0);transition:transform .5s cubic-bezier(.16,1,.3,1);pointer-events:none}
.pillar:hover{background:color-mix(in srgb,var(--accent) 3%,transparent)}
.pillar:hover::before{transform:scaleX(1)}
.pillar-icon{font-family:'Cinzel',serif;font-size:.5rem;letter-spacing:.3em;color:var(--accent);margin-bottom:1.5rem;display:block;opacity:.7}
.pillar-title{font-family:'Cinzel',serif;font-size:.88rem;font-weight:600;letter-spacing:.18em;color:var(--chrome);margin-bottom:1rem;text-transform:uppercase}
.pillar-text{font-size:.92rem;font-weight:300;line-height:1.9;color:var(--dim);font-style:italic}

/* TIERS */
.tiers{max-width:800px;margin:0 auto;padding:0 2rem 7rem;width:100%}
.tier{display:flex;align-items:flex-start;gap:2rem;padding:2.5rem 0;border-bottom:.5px solid color-mix(in srgb,var(--accent) 10%,transparent)}
.tier:last-child{border-bottom:none}
.tier-num{font-family:'Cinzel',serif;font-size:.5rem;letter-spacing:.3em;color:var(--accent);min-width:48px;padding-top:.2rem}
.tier-title{font-family:'Cinzel',serif;font-size:.8rem;font-weight:600;letter-spacing:.2em;color:var(--chrome);margin-bottom:.6rem;text-transform:uppercase}
.tier-text{font-size:.92rem;font-weight:300;font-style:italic;line-height:1.9;color:var(--dim)}

/* NOTICE (licensing box, etc.) */
.notice-wrap{max-width:700px;margin:0 auto;padding:0 2rem 6rem;width:100%}
.notice-box{border:.5px solid color-mix(in srgb,var(--accent) 25%,transparent);padding:2.5rem;position:relative;text-align:center}
.notice-box::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:60%;height:1px;background:linear-gradient(to right,transparent,var(--accent),transparent)}
.notice-title{font-family:'Cinzel',serif;font-size:.6rem;letter-spacing:.35em;color:var(--accent);text-transform:uppercase;margin-bottom:1.2rem}
.notice-text{font-size:.92rem;font-weight:300;font-style:italic;line-height:1.9;color:var(--dim)}

/* PORTAL */
.portal-wrap{max-width:960px;margin:0 auto;padding:0 2rem 8rem;width:100%}
#portalGate,#portalRedirect{border:.5px solid color-mix(in srgb,var(--accent) 25%,transparent);padding:4rem 3rem;position:relative;text-align:center;max-width:480px;margin:0 auto}
#portalGate::before,#portalRedirect::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:50%;height:1px;background:linear-gradient(to right,transparent,var(--accent),transparent)}
#portalRedirect{display:none;padding:3.5rem 3rem}
#portalRedirect.show{display:block}
.gate-title,.redirect-title{font-family:'Cinzel',serif;font-size:.62rem;letter-spacing:.4em;color:var(--accent);text-transform:uppercase;margin-bottom:.8rem}
.gate-sub{font-size:.88rem;font-weight:300;font-style:italic;color:var(--dim);margin-bottom:2.5rem;line-height:1.7}
#clerkSignIn{display:flex;justify-content:center;width:100%}
#clerkSignIn>*{width:100% !important;max-width:100% !important}
.redirect-name{font-family:'Cinzel',serif;font-size:1rem;font-weight:600;letter-spacing:.18em;color:var(--chrome);margin-bottom:.5rem}
.redirect-sub{font-size:.88rem;font-weight:300;font-style:italic;color:var(--dim);margin-bottom:2rem;line-height:1.7}
.redirect-btn{display:inline-block;background:transparent;border:.5px solid var(--accent);color:var(--accent);font-family:'Cinzel',serif;font-size:.56rem;letter-spacing:.38em;padding:1rem 2rem;cursor:pointer;text-transform:uppercase;transition:background .25s,color .25s;text-decoration:none}
.redirect-btn:hover{background:var(--accent);color:var(--bg)}
.redirect-rule{width:1px;height:32px;background:linear-gradient(to bottom,transparent,color-mix(in srgb,var(--accent) 30%,transparent),transparent);margin:1.8rem auto 0}

/* FOOTER */
footer{border-top:.5px solid color-mix(in srgb,var(--accent) 15%,transparent);padding:2.5rem 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.2rem;margin-top:auto}
.footer-back{font-family:'Cinzel',serif;font-size:.52rem;letter-spacing:.3em;color:var(--dim);text-decoration:none;text-transform:uppercase;transition:color .3s}
.footer-back:hover{color:var(--accent)}
.footer-links{display:flex;align-items:center;gap:.9rem;font-family:'Cinzel',serif;font-size:.48rem;letter-spacing:.25em;text-transform:uppercase}
.footer-links a{color:var(--dim);text-decoration:none;transition:color .3s}
.footer-links a:hover{color:var(--accent)}
.footer-links span{color:color-mix(in srgb,var(--dim) 40%,transparent)}
.footer-copy{font-family:'Cinzel',serif;font-size:.48rem;letter-spacing:.15em;color:color-mix(in srgb,var(--dim) 35%,transparent)}

@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
.reveal.visible{opacity:1;transform:translateY(0)}

/* Scramble text */
.scramble-word{display:inline-block;white-space:nowrap}
.scramble-char{display:inline-block;will-change:contents}

/* Clerk input override */
.cl-formFieldInput,[data-clerk-input],input.cl-formFieldInput{font-family:'Cormorant Garamond',Georgia,serif !important;font-size:1rem !important;letter-spacing:.04em !important;text-transform:none !important;font-variant:normal !important}

@media(max-width:600px){
  nav{padding:1.2rem}
  .nav-tag{display:none}
  .pillars{padding:0 1.2rem}
  .pillars-grid{grid-template-columns:1fr}
  .pillar,.pillar:first-child,.pillar:nth-child(2){grid-column:1;border-right:none;border-bottom:.5px solid color-mix(in srgb,var(--accent) 12%,transparent)}
  .pillar:last-child{border-bottom:none}
  .tiers{padding:0 1.2rem 5rem}
  .tier{gap:1.2rem}
  #portalGate,#portalRedirect{max-width:100%;padding:2rem 1.2rem;border-left:none;border-right:none}
  footer{flex-direction:column;text-align:center;padding:2rem 1.2rem}
