<script>
/* LVO Holdings — shared division-site behavior
   Expects window.LVO_PAGE = { accent: '#hex', dashboardUrl: 'https://...' } set inline before this script. */
(function () {
  const { accent, dashboardUrl } = window.LVO_PAGE || {};

  /* Scroll reveal */
  document.querySelectorAll('.reveal').forEach((r) => {
    new IntersectionObserver((entries, o) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('visible'); o.unobserve(e.target); }
      });
    }, { threshold: .08 }).observe(r);
  });

  /* Scramble text — cursor-proximity character scramble, word-wrapped so lines only break between words */
  const RADIUS = 20, DURATION = 200, CHARS = 'LVOᛪ༙';

  function buildWordSpan(word) {
    const span = document.createElement('span');
    span.className = 'scramble-word';
    for (const ch of word) {
      const c = document.createElement('span');
      c.className = 'scramble-char';
      c.dataset.orig = ch;
      c.textContent = ch;
      span.appendChild(c);
    }
    return span;
  }

  function splitTextNode(node) {
    const frag = document.createDocumentFragment();
    node.textContent.split(/(\s+)/).forEach((part) => {
      if (!part) return;
      frag.appendChild(/^\s+$/.test(part) ? document.createTextNode(part) : buildWordSpan(part));
    });
    return frag;
  }

  document.querySelectorAll('[data-scramble], [data-scramble-block]').forEach((el) => {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
    const nodes = [];
    let n;
    while ((n = walker.nextNode())) nodes.push(n);
    nodes.forEach((tn) => tn.textContent.trim() && tn.parentNode.replaceChild(splitTextNode(tn), tn));
  });

  const timers = new Map();
  function scrambleChar(span) {
    const orig = span.dataset.orig;
    if (!orig) return;
    if (timers.has(span)) clearInterval(timers.get(span));
    const start = performance.now();
    const id = setInterval(() => {
      const t = performance.now() - start;
      if (t < DURATION) {
        span.textContent = CHARS[Math.floor(Math.random() * CHARS.length)];
      } else {
        span.textContent = orig;
        clearInterval(id);
        timers.delete(span);
      }
    }, 33);
    timers.set(span, id);
  }

  let raf = null;
  document.addEventListener('pointermove', (e) => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = null;
      document.querySelectorAll('.scramble-char').forEach((span) => {
        const r = span.getBoundingClientRect();
        const dist = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
        if (dist < RADIUS && Math.random() < (1 - dist / RADIUS) * 0.35) scrambleChar(span);
      });
    });
  });

  /* Clerk auth wiring */
  const clerkAppearance = {
    variables: {
      colorBackground: '#050505', colorText: '#F0EEEC', colorPrimary: accent,
      colorInputBackground: 'transparent', colorInputText: '#F0EEEC',
      borderRadius: '0px', fontFamily: "'Cormorant Garamond',Georgia,serif"
    },
    elements: {
      card: { background: 'transparent', border: `.5px solid ${accent}40`, boxShadow: 'none', borderRadius: '0' },
      headerTitle: { fontFamily: "'Cinzel',serif", letterSpacing: '.2em', color: '#C8C8D0' },
      headerSubtitle: { color: '#888880', fontStyle: 'italic' },
      formFieldLabel: { color: '#888880', fontFamily: "'Cinzel',serif", letterSpacing: '.12em', fontSize: '.7rem' },
      formFieldInput: { background: 'transparent', border: `.5px solid ${accent}59`, borderRadius: '0', color: '#F0EEEC', fontFamily: "Georgia,'Times New Roman',serif", fontSize: '1rem', letterSpacing: '.04em', textTransform: 'none', fontVariant: 'normal' },
      formButtonPrimary: { background: 'transparent', border: `.5px solid ${accent}`, borderRadius: '0', color: accent, fontFamily: "'Cinzel',serif", letterSpacing: '.3em', textTransform: 'uppercase', boxShadow: 'none' },
      footerActionLink: { color: accent },
      dividerLine: { background: `${accent}33` },
      dividerText: { color: '#888880' },
      socialButtonsIconButton: { background: 'transparent', border: `.5px solid ${accent}40`, borderRadius: '0' },
      avatarBox: { border: `.5px solid ${accent}66`, borderRadius: '0' }
    }
  };

  window.addEventListener('load', async () => {
    await Clerk.load();

    const gate = document.getElementById('portalGate');
    const redirect = document.getElementById('portalRedirect');
    const navUserBtn = document.getElementById('navUserBtn');
    const clerkNavBtn = document.getElementById('clerkNavBtn');
    const signInEl = document.getElementById('clerkSignIn');
    let signInMounted = false;

    function showGate() {
      gate.style.display = 'block';
      redirect.classList.remove('show');
      navUserBtn.classList.remove('show');
      if (!signInMounted) {
        Clerk.mountSignIn(signInEl, { appearance: clerkAppearance, routing: 'virtual' });
        signInMounted = true;
        // Clerk autofocuses its first input on mount, which scrolls the page down — pin it back to top
        [0, 50, 300].forEach((t) => setTimeout(() => window.scrollTo(0, 0), t));
      }
    }

    function showSignedIn(user) {
      gate.style.display = 'none';
      redirect.classList.add('show');
      document.getElementById('redirectName').textContent = user.firstName || 'Member';
      navUserBtn.classList.add('show');
      Clerk.mountUserButton(clerkNavBtn, { appearance: clerkAppearance });
    }

    Clerk.user ? showSignedIn(Clerk.user) : showGate();
    Clerk.addListener(({ user }) => (user ? showSignedIn(user) : showGate()));

    document.querySelectorAll('.nav-dash-link, .redirect-btn').forEach((a) => (a.href = dashboardUrl));
  });
})();

  </script>
